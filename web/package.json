{
  "name": "project-manager-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "run-s -c e2e:up e2e:run e2e:down",
    "test:e2e:open": "cypress open",
    "e2e:stack": "docker compose -p project-manager-e2e --env-file cypress/stack.env -f ../compose.yaml",
    "e2e:up": "npm run -s e2e:stack -- up -d --wait --build",
    "e2e:run": "cypress run --browser chrome",
    "e2e:logs": "npm run -s e2e:stack -- logs",
    "e2e:down": "npm run -s e2e:stack -- down -v",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/ cypress/ cypress.config.ts",
    "format:check": "prettier --check src/ cypress/ cypress.config.ts"
  },
  "dependencies": {
    "@fontsource/encode-sans-semi-expanded": "^5.3.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "cypress": "^16.2.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^7.0.3",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "prettier": "3.9.6",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
